<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:name=".MyApp"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NewProjectMVVM">
        <activity
            android:name="com.example.project_miniMart.ui.flows.splash.SplashComposeActivity"
            android:exported="true"
            android:theme="@style/Theme.NewProjectMVVM">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.project_miniMart.ui.flows.homeFlow.HomeActivity"
            android:exported="false"
            />
        <activity
            android:name="com.example.project_miniMart.ui.flows.authFlow.AuthActivity"
            android:exported="false"
            />

    </application>

</manifest>